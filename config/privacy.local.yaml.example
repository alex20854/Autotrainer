# Copy to config/privacy.local.yaml (gitignored — NEVER commit the real one)
# and list the personal strings that must never appear in this public repo.
# privacy_check.py greps every commit for them, case-insensitively.
never_commit:
  - "Your Full Name"
  - "123 Your Street"
  - "Your Town"
  - "your.personal@email.com"
  - "555-555-5555"
  - "Your Employer"
  - "Name Of Your Gym"

# Opaque files — FIT, compressed files, archives — can carry GPS and cannot be
# inspected; list each reviewed one by its repo-relative path to let it be
# committed. (Compressed GPX/KML/KMZ/GeoJSON are refused even when listed.)
allow_files: []
#  - data/raw/c2/example-indoor-row.fit
